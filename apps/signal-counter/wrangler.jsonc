{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nativefragments-lit-counter",
  "main": ".nativefragments/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "routes": [
    { "pattern": "lit-counter.nativefragments.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "build": {
    "command": "node ../../scripts/build-app.mjs",
    "watch_dir": ["worker.js", "site", "client"]
  }
}
